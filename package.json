{
  "name": "smart-copy",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <27",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-smart-copy \"vitest run --config vitest.emulator.config.js\"",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy upgrade-preview --expires 7d --project smartcopy-195fd",
    "deploy": "npm run build && firebase deploy --only hosting --project smartcopy-195fd"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "firebase": "12.19.0",
    "formik": "2.4.9",
    "notistack": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "workbox-window": "7.4.1",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.30.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  }
}
