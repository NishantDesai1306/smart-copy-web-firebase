rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Legacy avatars used public tokenless URLs. Keep those readable, but immutable.
    match /{folder}/{legacyFile} {
      allow read: if folder == 'profile pictures';
      allow write: if false;
    }
    match /{folder}/{userId}/{path=**} {
      allow read: if folder == 'profile pictures' && request.auth != null && request.auth.uid == userId;
      allow write: if folder == 'profile pictures'
        && request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
