rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /items/{itemId} {
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
    }
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
